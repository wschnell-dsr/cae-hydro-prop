FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        tolerance       1e-07;
        relTol          0.01;
        smoother        GaussSeidel;
    }

    "(U|h|e|k|epsilon|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-07;
        relTol          0.01;
    }
}

PIMPLE
{
    momentumPredictor   yes;
    nNonOrthogonalCorrectors 0;
    nCorrectors       1;

    residualControl
    {
        p               1e-4;
        U               1e-5;
        "(h|e|k|epsilon|omega)" 1e-5;
    }
}

relaxationFactors
{
    fields
    {
        rho             1.00;
        p               0.70;
    }
    equations
    {
        p               0.70;
        U               0.30;
        h               0.10;
        e               0.10;
        ".*"            0.70;
    }
}


