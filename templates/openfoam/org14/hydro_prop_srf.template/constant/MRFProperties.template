FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      MRFProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

MRF
{
    cellZone    propellerFrame;

    origin      (0 0 0);
    axis        ({% for x in axis %} {{ x }}{% endfor %} );

    omega       {{ rpm }} [rpm];
    patches     ({% for blade in blades %} {{ blade }}{% endfor %} hub hub_cap );
}

