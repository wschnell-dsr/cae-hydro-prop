FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [temperature];

internalField   uniform {{ TInlet }};

boundaryField
{
    front
    {
        type            fixedValue;
        value           $internalField;
    }

    back
    {
        type            inletOutlet;
        inletValue      $internalField;
    }

    outerCylinder
    {
        type            zeroGradient;
    }

    wall
    {
        type            zeroGradient;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}


