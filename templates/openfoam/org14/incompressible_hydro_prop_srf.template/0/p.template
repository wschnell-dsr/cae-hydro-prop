FoamFile
{
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform {{ pRef }};

boundaryField
{
    front
    {
        type            zeroGradient;
    }

    back
    {
        type            fixedValue;
        value           uniform {{ pRef }};
    }

    outerCylinder
    {
        type            zeroGradient;
    }

    wall
    {
        type            zeroGradient;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

