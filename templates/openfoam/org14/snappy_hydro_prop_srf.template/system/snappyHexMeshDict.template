FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#includeEtc "caseDicts/mesh/generation/snappyHexMeshDict.cfg"

castellatedMesh true;
snap            true;
addLayers       {{ addLayers }};
geometry
{
    propeller.stl
    {
        type    triSurfaceMesh;
        name    propeller;
        file    "propeller.stl";
        regions
        {
            hub_cap
            {
                name hub_cap;
            }
            hub
            {
                name hub;
            }
            {% for blade in blades %}
            {{ blade.key }}
            {
                name {{ blade.key }};
            }
            {% endfor %}
        }
    }
    shaft
    {
        type searchableCylinder;
        point1 ({{ xmin_shaft }} 0 0);
        point2 ({{ xmax_shaft }} 0 0);
        radius {{ r_shaft }};
    }
    propellerFrame
    {
        type searchableCylinder;
        point1 ({{ xmin_prop_frame }} 0 0);
        point2 ({{ xmax_prop_frame }} 0 0);
        radius {{ r_prop_frame }};
    }
    outerCylinder
    {
        type searchableCylinder;
        point1 ({{ xmin }} 0 0);
        point2 ({{ xmax }} 0 0);
        radius {{ rmax }};
    }
}
castellatedMeshControls
{
    features
    (
        {
            file "propeller.extendedFeatureEdgeMesh";
            level {{ propeller_level_feature }};
        }
    );
    refinementSurfaces
    {
        propeller
        {
            level ({{ propeller_level_min }} {{ propeller_level_max }});
            regions
            {
                hub_cap
                {
                    level ({{ propeller_level_hub_min }} {{ propeller_level_hub_max }});
                    patchInfo
                    {
                        type wall;
                    }
                }
                hub
                {
                    level ({{ propeller_level_hub_min }} {{ propeller_level_hub_max }});
                    patchInfo
                    {
                        type wall;
                    }
                }
                {% for blade in blades %}
                {{ blade.key }}
                {
                    level ({{ propeller_level_blades_min }} {{ propeller_level_blades_max }});
                    patchInfo
                    {
                        type wall;
                    }
                }
                {% endfor %}
            }
        }
        shaft
        {
            level ({{ shaft_level_min }} {{ shaft_level_max }});
            patchInfo
            {
                type wall;
            }
        }
        propellerFrame
        {
            level ({{ propeller_frame_level_min }} {{ propeller_frame_level_max }});
            cellZone propellerFrame;
            faceZone propellerFrame;
            mode inside;
        }
        outerCylinder
        {
            level ({{ outer_cylinder_level_min }} {{ outer_cylinder_level_max }});
            patchInfo
            {
                type patch;
            }
        }
    }
    insidePoint ({{ x_inside_point }} {{ y_inside_point }} {{ z_inside_point }});
}
snapControls
{
    nSmoothPatch    {{ snapControls.nSmoothPatch }};
    tolerance       {{ snapControls.tolerance }};
    nSolveIter      {{ snapControls.nSolveIter }};
    nRelaxIter      {{ snapControls.nRelaxIter }};
    nFeatureSnapIter {{ snapControls.nFeatureSnapIter }};
    implicitFeatureSnap    {{ snapControls.implicitFeatureSnap }};
    explicitFeatureSnap    {{ snapControls.explicitFeatureSnap }};
}
addLayersControls
{
    relativeSizes false;
    layers
    {
        {% for blade in blades %}
        {{ blade.key }}
        {
            nSurfaceLayers {{ layers.blades }};
        }
        {% endfor %}
        hub
        {
            nSurfaceLayers {{ layers.hub }};
        }
        hub_cap
        {
            nSurfaceLayers {{ layers.hub_cap }};
        }
    }
    expansionRatio            1.2;
    finalLayerThickness    5.0e-4;
    minThickness            1e-20;
    nGrow                       1;
    featureAngle              180;
    nRelaxIter                 10;
    nSmoothSurfaceNormals       1;
    nSmoothNormals              3;
    nSmoothThickness           15;
    maxFaceThicknessRatio     1.0;
    maxThicknessToMedialRatio 1.0;
    minMedianAxisAngle          0;
    nBufferCellsNoExtrude       0;
    nLayerIter                 50;
}
mergeTolerance 1e-9;
