                        "columns": ["step", "f_p_x", "f_p_y", "f_p_z", "f_v_x", "f_v_y", "f_v_z", "m_p_x", "m_p_y", "m_p_z", "m_v_x", "m_v_y", "m_v_z"],
                        "output": "postProcessing/forcesIncompressible/forces.csv",
                        "expressions": {
                            "d": "0.1",
                            "f_x": "f_p_x",
                            "m_x": "m_p_x",
                            "j": "4.5 / ((9000.0/60.0) * d)",
                            "k_t": "-f_x / (1000*((9000.0/60.0)**2)*(d**4))",
                            "k_q": "m_x / (1000*((9000.0/60.0)**2)*(d**5))",
                            "P_shaft": "2.0 * 3.14159265359 * m_x * (9000.0/60.0)",
                            "Eff": "-(f_x * 4.5) / P_shaft"
                        }
                    }
                ]
            },
